# Source footage — large, and not ours to redistribute.
Data/

# Rendered deliverables. Regenerated by `scripts/render_video.py`; the README
# states out/ can be deleted at any time without breaking a re-run. The
# 18-minute capture alone renders to 1.03 GB, well past GitHub's 100 MB limit.
out/*.mp4
out/Old_output/

# Per-video intermediates. Rebuilt on demand by the pipeline; the encoded
# chunks are the same video again, split ten ways.
work/*/chunks/
work/*/stage0/
work/*/stage1/
work/*/stage2/
work/*/stage5/
work/*/render_stats.json

# The auto-labelled training set (~345 MB of generated jpg/png). Rebuilt with
# `train_fieldnet.py dataset` — see the README for the per-capture commands.
work/fieldnet/img/
work/fieldnet/lbl/
work/fieldnet/index.json

# Kept deliberately, small and expensive to reproduce:
#   out/field_template.json      standing reference, never regenerated
#   work/fieldnet/*.pt           trained weights (1.9 MB each); the dataset
#                                they came from is ~1 h to rebuild
#   work/regress/snap_baseline.json   the regression reference snapshot

__pycache__/
*.py[cod]
.venv/
venv/
